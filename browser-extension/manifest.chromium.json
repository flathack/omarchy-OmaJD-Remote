{
  "manifest_version": 3,
  "name": "OmaJD-Remote Click'n'Load",
  "version": "0.6.1",
  "description": "Forwards Click'n'Load buttons to the local OmaJD-Remote inbox.",
  "permissions": [],
  "host_permissions": [
    "http://127.0.0.1:9666/*",
    "http://localhost:9666/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["page-bridge.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content-script.js"],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
