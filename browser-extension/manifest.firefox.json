{
  "manifest_version": 3,
  "name": "OmaJD-Remote Click'n'Load",
  "version": "0.6.2",
  "description": "Forwards Click'n'Load buttons to the local OmaJD-Remote inbox.",
  "permissions": [],
  "host_permissions": [
    "http://127.0.0.1:9666/*",
    "http://localhost:9666/*"
  ],
  "background": {
    "scripts": ["service-worker.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["page-bridge.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content-script.js"],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "clicknload@omajd-remote.flathack.github.io",
      "data_collection_permissions": {
        "required": ["websiteActivity", "websiteContent"]
      },
      "strict_min_version": "128.0"
    }
  }
}
